{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/jira-proxy",
      "destination": "/api/jira-proxy.js"
    },
    {
      "source": "/api/ai-enhance",
      "destination": "/api/ai-enhance.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
